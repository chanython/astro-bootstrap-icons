{
  "name": "astro-bootstrap-icons",
  "version": "1.2.0",
  "description": "Bootstrap Icons for Astro",
  "files": [
    "dist/"
  ],
  "exports": {
    "./*": "./dist/*.astro",
    "./assets/*.css": "./dist/assets/*.css",
    "./assets/*.scss": "./dist/assets/*.scss"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsx ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanython/astro-bootstrap-icons.git"
  },
  "keywords": [
    "astro",
    "astro-component",
    "astro-integration",
    "bootstrap",
    "component",
    "components",
    "icon",
    "icons",
    "svg",
    "ui",
    "withastro"
  ],
  "author": "Chan Thongjerm (https://github.com/chanython)",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/chanython/astro-bootstrap-icons/issues"
  },
  "homepage": "https://github.com/chanython/astro-bootstrap-icons#readme",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "astro": "^7.0.7",
    "bootstrap-icons": "^1.13.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
